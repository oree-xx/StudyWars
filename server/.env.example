# Copy this file to .env and fill in your own values.
# Gemini is the default LLM provider. Get a key from https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional alternative: set LLM_PROVIDER=anthropic and fill in this key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Use the Redis TCP connection URL, not the Upstash REST endpoint or token.
# Production requires Redis; Upstash URLs must use rediss:// for TLS.
REDIS_URL=
ROOM_STORAGE=auto
ROOM_TTL_SECONDS=86400
REDIS_KEY_PREFIX=studywars

# The URL your React frontend runs on (Vite default shown).
FRONTEND_ORIGIN=http://localhost:5173
